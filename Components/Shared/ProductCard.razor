<div class="card mb-3">

  <div class="card-body">

    <h5 class="card-title">
      @Name
    </h5>

    <p class="card-text">
      Price: @Price
    </p>

    <p class="card-text">
      Category: @CategoryName
    </p>

    <button class="btn btn-primary" @onclick="HandleSelectAsync">

      Select

    </button>


    @if (ShowAdminActions)
    {
      <a class="btn btn-warning ms-2" href="@($"products/edit/{Id}")">

        Edit

      </a>

      <button class="btn btn-danger ms-2" @onclick="HandleDeleteAsync">

        Delete

      </button>
    }

  </div>

</div>


@code
{
  [Parameter]
  public int Id { get; set; }


  [Parameter]
  public string Name { get; set; } = "";


  [Parameter]
  public decimal Price { get; set; }


  [Parameter]
  public string CategoryName { get; set; } = "";


  [Parameter]
  public bool ShowAdminActions { get; set; }


  [Parameter]
  public EventCallback<string> OnSelected { get; set; }


  [Parameter]
  public EventCallback<int> OnDelete { get; set; }


  private async Task HandleSelectAsync()
  {
    await OnSelected.InvokeAsync(Name);
  }


  private async Task HandleDeleteAsync()
  {
    await OnDelete.InvokeAsync(Id);
  }
}