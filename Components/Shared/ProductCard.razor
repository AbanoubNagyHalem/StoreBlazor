<div class="product-card">

  <div class="product-card-content">

    <div class="product-header">

      <div>
        <span class="category-badge">
          @CategoryName
        </span>

        <h3 class="product-name">
          @Name
        </h3>
      </div>

      <div class="product-price">
        @Price.ToString("N2")
      </div>

    </div>

    <div class="product-actions">

      <button type="button" class="btn btn-outline-primary" @onclick="HandleSelectAsync">

        Select

      </button>

      @if (ShowAdminActions)
      {
        <a class="btn btn-outline-warning" href="@($"products/edit/{Id}")">

          Edit

        </a>

        <button type="button" class="btn btn-outline-danger" @onclick="HandleDeleteAsync">

          Delete

        </button>
      }

    </div>

  </div>

</div>

@code {
  [Parameter]
  public int Id { get; set; }

  [Parameter]
  public string Name { get; set; } = "";

  [Parameter]
  public decimal Price { get; set; }

  [Parameter]
  public string CategoryName { get; set; } = "";

  [Parameter]
  public bool ShowAdminActions { get; set; }

  [Parameter]
  public EventCallback<string> OnSelected { get; set; }

  [Parameter]
  public EventCallback<int> OnDelete { get; set; }

  private async Task HandleSelectAsync()
  {
    await OnSelected.InvokeAsync(Name);
  }

  private async Task HandleDeleteAsync()
  {
    await OnDelete.InvokeAsync(Id);
  }
}