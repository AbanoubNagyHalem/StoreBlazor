@page "/categories"

@inject CategoryApiClient CategoryApiClient
@inject AuthStateService AuthState
@inject ApiErrorMessageProvider ApiErrorMessageProvider
@inject IJSRuntime JS

<PageTitle>Categories</PageTitle>

<div class="categories-page">

  <div class="page-header">

    <div>

      <span class="page-eyebrow">
        CATEGORIES
      </span>

      <h1>
        Categories
      </h1>

      <p>
        Browse and manage product categories.
      </p>

    </div>


    @if (isAdmin)
    {
      <a class="btn btn-dark" href="/categories/create">

        + Add Category

      </a>
    }

  </div>


  <ErrorState Message="@errorMessage" />


  @if (successMessage is not null)
  {
    <div class="alert alert-success">
      @successMessage
    </div>
  }


  @if (isLoading)
  {
    <LoadingState Message="Loading categories..." />
  }
  else if (categories.Count == 0)
  {
    <EmptyState Icon="🗂️" Title="No categories yet" Message="Categories will appear here once they are created." />
  }
  else
  {
    <div class="categories-grid">

      <DataList Items="@categories">

        <ItemTemplate Context="category">

          <div class="category-card">

            <div class="category-icon">
              🗂️
            </div>

            <div class="category-content">

              <div class="category-label">
                CATEGORY
              </div>

              <h3 class="category-name">
                @category.Name
              </h3>

            </div>

            @if (isAdmin)
            {
              <div class="category-actions">

                <a class="btn btn-sm btn-outline-warning" href="@($"categories/edit/{category.Id}")">

                  Edit

                </a>

                <button type="button" class="btn btn-sm btn-outline-danger" disabled="@isDeleting"
                        @onclick="() => DeleteCategoryAsync(category.Id)">

                  Delete

                </button>

              </div>
            }

          </div>

        </ItemTemplate>

      </DataList>

    </div>
  }

</div>


@code {
  [CascadingParameter]
  private Task<AuthenticationState>? AuthenticationStateTask
  {
    get;
    set;
  }


  private List<CategoryResponse> categories =
      [];


  private bool isLoading = true;

  private bool isDeleting;

  private bool isAdmin;


  private string? errorMessage;

  private string? successMessage;


  protected override async Task OnInitializedAsync()
  {
    await LoadCategoriesAsync();
  }


  protected override async Task OnAfterRenderAsync(
      bool firstRender)
  {
    if (!firstRender)
    {
      return;
    }


    await AuthState.LoadUserAsync();


    if (AuthenticationStateTask is not null)
    {
      AuthenticationState state =
          await AuthenticationStateTask;


      isAdmin =
          state.User.IsInRole(
              "Admin");
    }


    StateHasChanged();
  }


  private async Task LoadCategoriesAsync()
  {
    try
    {
      isLoading = true;

      errorMessage = null;


      categories =
          await CategoryApiClient.GetAllAsync();
    }
    catch (HttpRequestException)
    {
      errorMessage =
          "Could not load categories from the API.";
    }
    finally
    {
      isLoading = false;
    }
  }


  private async Task DeleteCategoryAsync(
      int categoryId)
  {
    bool confirmed =
        await JS.InvokeAsync<bool>(
            "confirm",
            "Are you sure you want to delete this category?");


    if (!confirmed)
    {
      return;
    }


    try
    {
      isDeleting = true;

      errorMessage = null;

      successMessage = null;


      HttpResponseMessage response =
          await CategoryApiClient.DeleteAsync(
              categoryId);


      if (response.IsSuccessStatusCode)
      {
        successMessage =
            "Category deleted successfully.";

        await LoadCategoriesAsync();

        return;
      }


      if (response.StatusCode ==
          System.Net.HttpStatusCode.NotFound)
      {
        errorMessage =
            "Category was not found.";

        return;
      }


      if (response.StatusCode ==
              System.Net.HttpStatusCode.Conflict ||
          response.StatusCode ==
              System.Net.HttpStatusCode.BadRequest)
      {
        errorMessage =
            "This category cannot be deleted because it has products assigned to it.";

        return;
      }


      errorMessage =
          ApiErrorMessageProvider.GetMessage(
              response.StatusCode,
              $"Could not delete category. Status: {(int)response.StatusCode}");
    }
    catch (HttpRequestException)
    {
      errorMessage =
          "Could not connect to the API.";
    }
    finally
    {
      isDeleting = false;
    }
  }
}