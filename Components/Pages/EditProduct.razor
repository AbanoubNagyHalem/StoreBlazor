@page "/products/edit/{Id:int}"
@rendermode InteractiveServer

@inject ProductApiClient ProductApiClient
@inject CategoryApiClient CategoryApiClient
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>Edit Product</PageTitle>


<div class="form-page">

  <div class="form-page-header">

    <div>
      <span class="page-eyebrow">
        PRODUCTS
      </span>

      <h1>
        Edit Product
      </h1>

      <p>
        Update product information.
      </p>
    </div>

  </div>


  @if (successMessage is not null)
  {
    <div class="alert alert-success">
      @successMessage
    </div>
  }


  @if (errorMessage is not null)
  {
    <div class="alert alert-danger">
      @errorMessage
    </div>
  }


  @if (isLoading)
  {
    <div class="loading-box">

      <div class="spinner-border"></div>

      <span>
        Loading product...
      </span>

    </div>
  }
  else if (notFound)
  {
    <div class="alert alert-warning">
      Product not found.
    </div>
  }
  else
  {
    <ProductForm Model="@model" Categories="@categories" IsSubmitting="@isSubmitting" SubmitText="Save Changes"
                 SubmittingText="Saving..." ShowCancel="true" OnValidSubmit="HandleUpdateAsync" OnCancel="GoBack" />
  }

</div>


@code {
  [Parameter]
  public int Id { get; set; }


  private ProductFormModel model =
      new();


  private List<CategoryResponse> categories =
      [];


  private bool isLoading = true;

  private bool isSubmitting;

  private bool notFound;


  private string? successMessage;

  private string? errorMessage;


  protected override async Task OnAfterRenderAsync(
      bool firstRender)
  {
    if (!firstRender)
    {
      return;
    }

    try
    {
      await AuthState.LoadUserAsync();


      categories =
          await CategoryApiClient.GetAllAsync();


      ProductResponse? product =
          await ProductApiClient.GetByIdAsync(
              Id);


      if (product is null)
      {
        notFound = true;

        return;
      }


      model =
          new ProductFormModel
          {
            Name = product.Name,
            Price = product.Price,
            CategoryId = product.CategoryId
          };
    }
    catch (HttpRequestException)
    {
      errorMessage =
          "Could not load product data.";
    }
    finally
    {
      isLoading = false;

      StateHasChanged();
    }
  }


  private async Task HandleUpdateAsync()
  {
    try
    {
      isSubmitting = true;

      successMessage = null;

      errorMessage = null;


      UpdateProductRequest request =
          new()
          {
            Name = model.Name,
            Price = model.Price,
            CategoryId = model.CategoryId
          };


      HttpResponseMessage response =
          await ProductApiClient.UpdateAsync(
              Id,
              request);


      if (response.IsSuccessStatusCode)
      {
        successMessage =
            "Product updated successfully.";

        return;
      }


      errorMessage =
          $"Could not update product. Status: {(int)response.StatusCode}";
    }
    catch (HttpRequestException)
    {
      errorMessage =
          "Could not connect to the API.";
    }
    finally
    {
      isSubmitting = false;
    }
  }


  private void GoBack()
  {
    Navigation.NavigateTo(
        "/products");
  }
}