@page "/products/edit/{Id:int}"

@inject ProductApiClient ProductApiClient
@inject CategoryApiClient CategoryApiClient
@inject AdminPageGuard AdminPageGuard
@inject NavigationManager Navigation

<PageTitle>Edit Product</PageTitle>


<div class="form-page">

  <div class="form-page-header">

    <span class="page-eyebrow">
      PRODUCTS
    </span>

    <h1>
      Edit Product
    </h1>

    <p>
      Update product information.
    </p>

  </div>


  @if (errorMessage is not null)
  {
    <div class="alert alert-danger">
      @errorMessage
    </div>
  }


  @if (successMessage is not null)
  {
    <div class="alert alert-success">
      @successMessage
    </div>
  }


  @if (isLoading)
  {
    <div class="loading-box">

      <div class="spinner-border"></div>

      <span>
        Loading product...
      </span>

    </div>
  }
  else if (notFound)
  {
    <div class="not-found-box">

      <h3>
        Product not found
      </h3>

      <p>
        The product does not exist.
      </p>

      <button class="btn btn-outline-secondary" @onclick="GoBack">

        Back to Products

      </button>

    </div>
  }
  else
  {
    <div class="product-form">

      <EditForm Model="@model" OnValidSubmit="HandleUpdateAsync">

        <DataAnnotationsValidator />

        <ValidationSummary />


        <div class="mb-4">

          <label class="form-label">
            Product Name
          </label>

          <InputText class="form-control" @bind-Value="model.Name" />

          <ValidationMessage For="@(() => model.Name)" />

        </div>


        <div class="mb-4">

          <label class="form-label">
            Price
          </label>

          <InputNumber class="form-control" @bind-Value="model.Price" />

          <ValidationMessage For="@(() => model.Price)" />

        </div>


        <div class="mb-4">

          <label class="form-label">
            Category
          </label>

          <InputSelect class="form-select" @bind-Value="model.CategoryId">

            <option value="0">
              Select a category
            </option>

            @foreach (
                CategoryResponse category
                in categories)
            {
              <option value="@category.Id">
                @category.Name
              </option>
            }

          </InputSelect>

          <ValidationMessage For="@(() => model.CategoryId)" />

        </div>


        <div class="form-actions">

          <button type="submit" class="btn btn-dark" disabled="@isSubmitting">

            @if (isSubmitting)
            {
              <span class="spinner-border spinner-border-sm me-2"></span>

              <span>
                Saving...
              </span>
            }
            else
            {
              <span>
                Save Changes
              </span>
            }

          </button>


          <button type="button" class="btn btn-outline-secondary" disabled="@isSubmitting" @onclick="GoBack">

            Cancel

          </button>

        </div>

      </EditForm>

    </div>
  }

</div>


@code {
  [Parameter]
  public int Id { get; set; }


  private UpdateProductRequest model =
      new();


  private List<CategoryResponse> categories =
      [];


  private bool isLoading = true;

  private bool isSubmitting;

  private bool notFound;


  private string? errorMessage;

  private string? successMessage;


  protected override async Task OnAfterRenderAsync(
      bool firstRender)
  {
    if (!firstRender)
    {
      return;
    }


    bool allowed =
        await AdminPageGuard.EnsureAdminAsync(
            "/products");


    if (!allowed)
    {
      return;
    }


    try
    {
      categories =
          await CategoryApiClient.GetAllAsync();


      ProductResponse? product =
          await ProductApiClient.GetByIdAsync(
              Id);


      if (product is null)
      {
        notFound = true;

        return;
      }


      model =
          new UpdateProductRequest
          {
            Name = product.Name,
            Price = product.Price,
            CategoryId =
                  product.CategoryId
          };
    }
    catch (HttpRequestException)
    {
      errorMessage =
          "Could not load product.";
    }
    finally
    {
      isLoading = false;

      StateHasChanged();
    }
  }


  private async Task HandleUpdateAsync()
  {
    try
    {
      isSubmitting = true;

      errorMessage = null;

      successMessage = null;


      HttpResponseMessage response =
          await ProductApiClient.UpdateAsync(
              Id,
              model);


      if (response.IsSuccessStatusCode)
      {
        successMessage =
            "Product updated successfully.";

        return;
      }


      if (response.StatusCode ==
          System.Net.HttpStatusCode.NotFound)
      {
        notFound = true;

        return;
      }


      if (response.StatusCode ==
          System.Net.HttpStatusCode.Conflict)
      {
        errorMessage =
            "A product with this name already exists.";

        return;
      }


      if (response.StatusCode ==
          System.Net.HttpStatusCode.Unauthorized ||
          response.StatusCode ==
          System.Net.HttpStatusCode.Forbidden)
      {
        errorMessage =
            "You do not have permission to edit this product.";

        return;
      }


      errorMessage =
          $"Could not update product. Status: {(int)response.StatusCode}";
    }
    catch (HttpRequestException)
    {
      errorMessage =
          "Could not connect to the API.";
    }
    finally
    {
      isSubmitting = false;
    }
  }


  private void GoBack()
  {
    Navigation.NavigateTo(
        "/products");
  }
}