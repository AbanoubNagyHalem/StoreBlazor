@page "/products/create"
@rendermode InteractiveServer

@implements IAsyncDisposable

@inject ProductApiClient ProductApiClient
@inject CategoryApiClient CategoryApiClient
@inject AdminPageGuard AdminPageGuard
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Create Product</PageTitle>


<div class="form-page">

  <div class="form-page-header">

    <span class="page-eyebrow">
      PRODUCTS
    </span>

    <h1>
      Create Product
    </h1>

    <p>
      Add a new product to your store.
    </p>

  </div>


  @if (errorMessage is not null)
  {
    <div class="alert alert-danger">
      @errorMessage
    </div>
  }


  @if (successMessage is not null)
  {
    <div class="alert alert-success">
      @successMessage
    </div>
  }


  @if (isLoading)
  {
    <div class="loading-box">

      <div class="spinner-border"></div>

      <span>
        Loading form...
      </span>

    </div>
  }
  else
  {
    <div class="product-form">

      <EditForm Model="@model" OnValidSubmit="HandleCreateAsync">

        <DataAnnotationsValidator />

        <ValidationSummary />


        <div class="mb-4">

          <label class="form-label">
            Product Name
          </label>

          <InputText class="form-control" @bind-Value="model.Name" placeholder="Enter product name" />

          <ValidationMessage For="@(() => model.Name)" />

        </div>


        <div class="mb-4">

          <label class="form-label">
            Price
          </label>

          <InputNumber class="form-control" @bind-Value="model.Price" />

          <ValidationMessage For="@(() => model.Price)" />

        </div>


        <div class="mb-4">

          <label class="form-label">
            Category
          </label>

          <InputSelect class="form-select" @bind-Value="model.CategoryId">

            <option value="0">
              Select a category
            </option>

            @foreach (
                CategoryResponse category
                in categories)
            {
              <option value="@category.Id">
                @category.Name
              </option>
            }

          </InputSelect>

          <ValidationMessage For="@(() => model.CategoryId)" />

        </div>


        <div class="form-actions">

          <button type="submit" class="btn btn-dark" disabled="@isSubmitting">

            @if (isSubmitting)
            {
              <span class="spinner-border spinner-border-sm me-2"></span>

              <span>
                Creating...
              </span>
            }
            else
            {
              <span>
                Create Product
              </span>
            }

          </button>


          <button type="button" class="btn btn-outline-secondary" disabled="@isSubmitting" @onclick="GoBack">

            Cancel

          </button>

        </div>

      </EditForm>

    </div>
  }

</div>


@code {
  private CreateProductRequest model =
      new();


  private List<CategoryResponse> categories =
      [];


  private IJSObjectReference? module;


  private bool isLoading = true;

  private bool isSubmitting;


  private string? errorMessage;

  private string? successMessage;


  protected override async Task OnAfterRenderAsync(
      bool firstRender)
  {
    if (!firstRender)
    {
      return;
    }


    bool allowed =
        await AdminPageGuard.EnsureAdminAsync(
            "/products");


    if (!allowed)
    {
      return;
    }


    try
    {
      module =
          await JS.InvokeAsync<IJSObjectReference>(
              "import",
              "./js/createProduct.js");


      categories =
          await CategoryApiClient.GetAllAsync();
    }
    catch (HttpRequestException)
    {
      errorMessage =
          "Could not load categories.";
    }
    catch (JSException)
    {
      errorMessage =
          "Could not load JavaScript module.";
    }
    finally
    {
      isLoading = false;

      StateHasChanged();
    }
  }


  private async Task HandleCreateAsync()
  {
    try
    {
      isSubmitting = true;

      errorMessage = null;

      successMessage = null;


      HttpResponseMessage response =
          await ProductApiClient.CreateAsync(
              model);


      if (response.IsSuccessStatusCode)
      {
        successMessage =
            "Product created successfully.";


        model =
            new CreateProductRequest();


        if (module is not null)
        {
          await module.InvokeVoidAsync(
              "scrollToTop");
        }


        return;
      }


      if (response.StatusCode ==
          System.Net.HttpStatusCode.Unauthorized)
      {
        errorMessage =
            "Your session is not authorized.";

        return;
      }


      if (response.StatusCode ==
          System.Net.HttpStatusCode.Forbidden)
      {
        errorMessage =
            "You do not have permission to create products.";

        return;
      }


      if (response.StatusCode ==
          System.Net.HttpStatusCode.NotFound)
      {
        errorMessage =
            "The selected category was not found.";

        return;
      }


      if (response.StatusCode ==
          System.Net.HttpStatusCode.Conflict)
      {
        errorMessage =
            "A product with this name already exists.";

        return;
      }


      errorMessage =
          $"Could not create product. Status: {(int)response.StatusCode}";
    }
    catch (HttpRequestException)
    {
      errorMessage =
          "Could not connect to the API.";
    }
    catch (JSException)
    {
      errorMessage =
          "The product was created, but the page interaction failed.";
    }
    finally
    {
      isSubmitting = false;
    }
  }


  private void GoBack()
  {
    Navigation.NavigateTo(
        "/products");
  }


  public async ValueTask DisposeAsync()
  {
    if (module is not null)
    {
      try
      {
        await module.DisposeAsync();
      }
      catch (JSDisconnectedException)
      {
      }
    }
  }
}