@page "/products/create"
@rendermode InteractiveServer

@inject ProductApiClient ProductApiClient
@inject CategoryApiClient CategoryApiClient
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>Create Product</PageTitle>


<div class="form-page">

  <div class="form-page-header">

    <div>
      <span class="page-eyebrow">
        PRODUCTS
      </span>

      <h1>
        Create Product
      </h1>

      <p>
        Add a new product to your store.
      </p>
    </div>

  </div>


  @if (successMessage is not null)
  {
    <div class="alert alert-success">
      @successMessage
    </div>
  }


  @if (errorMessage is not null)
  {
    <div class="alert alert-danger">
      @errorMessage
    </div>
  }


  @if (isLoading)
  {
    <div class="loading-box">

      <div class="spinner-border"></div>

      <span>
        Loading form...
      </span>

    </div>
  }
  else
  {
    <ProductForm Model="@model" Categories="@categories" IsSubmitting="@isSubmitting" SubmitText="Create Product"
                 SubmittingText="Creating..." ShowCancel="true" OnValidSubmit="HandleCreateAsync" OnCancel="GoBack" />
  }

</div>


@code {
  private ProductFormModel model = new();

  private List<CategoryResponse> categories = [];

  private bool isLoading = true;

  private bool isSubmitting;

  private string? successMessage;

  private string? errorMessage;


  protected override async Task OnAfterRenderAsync(
      bool firstRender)
  {
    if (!firstRender)
    {
      return;
    }

    try
    {
      await AuthState.LoadUserAsync();

      categories =
          await CategoryApiClient.GetAllAsync();
    }
    catch (HttpRequestException)
    {
      errorMessage =
          "Could not load form data.";
    }
    finally
    {
      isLoading = false;

      StateHasChanged();
    }
  }


  private async Task HandleCreateAsync()
  {
    try
    {
      isSubmitting = true;

      successMessage = null;

      errorMessage = null;


      CreateProductRequest request =
          new()
          {
            Name = model.Name,
            Price = model.Price,
            CategoryId = model.CategoryId
          };


      HttpResponseMessage response =
          await ProductApiClient.CreateAsync(
              request);


      if (response.IsSuccessStatusCode)
      {
        successMessage =
            "Product created successfully.";

        model =
            new ProductFormModel();

        return;
      }


      errorMessage =
          $"Could not create product. Status: {(int)response.StatusCode}";
    }
    catch (HttpRequestException)
    {
      errorMessage =
          "Could not connect to the API.";
    }
    finally
    {
      isSubmitting = false;
    }
  }


  private void GoBack()
  {
    Navigation.NavigateTo(
        "/products");
  }
}