@page "/products/create"
@rendermode InteractiveServer

@inject ProductApiClient ProductApiClient
@inject CategoryApiClient CategoryApiClient
@inject AuthStateService AuthState

<PageTitle>Create Product</PageTitle>

<h1>Create Product</h1>

<p>
  Create a new product in the Store.
</p>


@if (successMessage is not null)
{
  <div class="alert alert-success">
    @successMessage
  </div>
}


@if (errorMessage is not null)
{
  <div class="alert alert-danger">
    @errorMessage
  </div>
}


@if (isLoading)
{
  <div class="alert alert-info">
    Loading...
  </div>
}
else
{
  <EditForm Model="model" OnValidSubmit="HandleValidSubmitAsync">

    <DataAnnotationsValidator />

    <ValidationSummary />


    <div class="mb-3">

      <label class="form-label">
        Name
      </label>

      <InputText class="form-control" @bind-Value="model.Name" />

      <ValidationMessage For="@(() => model.Name)" />

    </div>


    <div class="mb-3">

      <label class="form-label">
        Price
      </label>

      <InputNumber class="form-control" @bind-Value="model.Price" />

      <ValidationMessage For="@(() => model.Price)" />

    </div>


    <div class="mb-3">

      <label class="form-label">
        Category
      </label>

      <InputSelect class="form-select" @bind-Value="model.CategoryId">

        <option value="0">
          Select category
        </option>


        @foreach (
            var category in categories)
        {
          <option value="@category.Id">
            @category.Name
          </option>
        }

      </InputSelect>

      <ValidationMessage For="@(() => model.CategoryId)" />

    </div>


    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">

      @if (isSubmitting)
      {
        <span>
          Creating...
        </span>
      }
      else
      {
        <span>
          Create Product
        </span>
      }

    </button>

  </EditForm>
}


@code
{
  private CreateProductRequest model =
      new();


  private List<CategoryResponse> categories =
      [];


  private bool isLoading = true;

  private bool isSubmitting;


  private string? successMessage;

  private string? errorMessage;


  protected override async Task
      OnAfterRenderAsync(
          bool firstRender)
  {
    if (!firstRender)
    {
      return;
    }


    try
    {
      await AuthState
          .LoadUserAsync();


      categories =
          await CategoryApiClient
              .GetAllAsync();


      Console.WriteLine(
          $"Create Page Token Exists: {!string.IsNullOrWhiteSpace(AuthState.Token)}");

      Console.WriteLine(
          $"Create Page Role: {AuthState.Role}");
    }
    catch (HttpRequestException)
    {
      errorMessage =
          "Could not load data from the API.";
    }
    finally
    {
      isLoading = false;

      StateHasChanged();
    }
  }


  private async Task
      HandleValidSubmitAsync()
  {
    try
    {
      isSubmitting = true;

      successMessage = null;

      errorMessage = null;


      if (!AuthState.IsAuthenticated)
      {
        errorMessage =
            "You must login first.";

        return;
      }


      HttpResponseMessage response =
          await ProductApiClient
              .CreateAsync(model);


      if (response.IsSuccessStatusCode)
      {
        successMessage =
            "Product created successfully.";

        model =
            new CreateProductRequest();

        return;
      }


      errorMessage =
          $"Could not create product. Status: {(int)response.StatusCode}";
    }
    catch (HttpRequestException)
    {
      errorMessage =
          "Could not connect to the API.";
    }
    finally
    {
      isSubmitting = false;
    }
  }
}