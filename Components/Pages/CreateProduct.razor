@page "/products/create"
@rendermode InteractiveServer

@inject ProductApiClient ProductApiClient
@inject CategoryApiClient CategoryApiClient

<PageTitle>Create Product</PageTitle>

<h1>Create Product</h1>

<p>Create a new product in the Store.</p>

@if (successMessage is not null)
{
  <div class="alert alert-success">
    @successMessage
  </div>
}

@if (errorMessage is not null)
{
  <div class="alert alert-danger">
    @errorMessage
  </div>
}

@if (isLoadingCategories)
{
  <p>Loading categories...</p>
}
else
{
  <EditForm Model="model" OnValidSubmit="HandleValidSubmitAsync">

    <DataAnnotationsValidator />

    <ValidationSummary />

    <div class="mb-3">
      <label class="form-label">
        Name
      </label>

      <InputText class="form-control" @bind-Value="model.Name" />

      <ValidationMessage For="@(() => model.Name)" />
    </div>

    <div class="mb-3">
      <label class="form-label">
        Price
      </label>

      <InputNumber class="form-control" @bind-Value="model.Price" />

      <ValidationMessage For="@(() => model.Price)" />
    </div>

    <div class="mb-3">
      <label class="form-label">
        Category
      </label>

      <InputSelect class="form-select" @bind-Value="model.CategoryId">

        <option value="0">
          Select category
        </option>

        @foreach (var category in categories)
        {
          <option value="@category.Id">
            @category.Name
          </option>
        }

      </InputSelect>

      <ValidationMessage For="@(() => model.CategoryId)" />
    </div>

    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">

      @if (isSubmitting)
      {
        <span>Creating...</span>
      }
      else
      {
        <span>Create Product</span>
      }

    </button>

  </EditForm>
}

@code
{
  private CreateProductRequest model = new();

  private List<CategoryResponse> categories = [];

  private bool isLoadingCategories = true;

  private bool isSubmitting;

  private string? successMessage;

  private string? errorMessage;

  protected override async Task OnInitializedAsync()
  {
    try
    {
      categories =
          await CategoryApiClient.GetAllAsync();
    }
    catch (HttpRequestException)
    {
      errorMessage =
          "Could not load categories from the API.";
    }
    finally
    {
      isLoadingCategories = false;
    }
  }

  private async Task HandleValidSubmitAsync()
  {
    try
    {
      isSubmitting = true;

      successMessage = null;
      errorMessage = null;

      HttpResponseMessage response =
          await ProductApiClient.CreateAsync(model);

      if (response.IsSuccessStatusCode)
      {
        successMessage =
            "Product created successfully.";

        model = new CreateProductRequest();

        return;
      }

      errorMessage =
          $"Could not create product. Status: {(int)response.StatusCode}";
    }
    catch (HttpRequestException)
    {
      errorMessage =
          "Could not connect to the API.";
    }
    finally
    {
      isSubmitting = false;
    }
  }
}