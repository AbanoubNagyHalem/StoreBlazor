@page "/products"
@rendermode InteractiveServer

@inject ProductApiClient ProductApiClient
@inject CategoryApiClient CategoryApiClient
@inject AuthStateService AuthState
@inject IJSRuntime JS

<PageTitle>Products</PageTitle>


<h1>Products</h1>


@if (errorMessage is not null)
{
  <div class="alert alert-danger">
    @errorMessage
  </div>
}


<div class="row g-3 mb-4">

  <div class="col-md-4">

    <label class="form-label">
      Search
    </label>

    <input class="form-control" @bind="query.Search" @bind:event="oninput" />

  </div>


  <div class="col-md-3">

    <label class="form-label">
      Category
    </label>

    <select class="form-select" @bind="query.CategoryId">

      <option value="">
        All Categories
      </option>

      @foreach (var category in categories)
      {
        <option value="@category.Id">
          @category.Name
        </option>
      }

    </select>

  </div>


  <div class="col-md-2">

    <label class="form-label">
      Sort By
    </label>

    <select class="form-select" @bind="query.SortBy">

      <option value="">
        Default
      </option>

      <option value="name">
        Name
      </option>

      <option value="price">
        Price
      </option>

      <option value="id">
        Id
      </option>

    </select>

  </div>


  <div class="col-md-2">

    <label class="form-label">
      Direction
    </label>

    <select class="form-select" @bind="query.SortDirection">

      <option value="asc">
        Ascending
      </option>

      <option value="desc">
        Descending
      </option>

    </select>

  </div>


  <div class="col-md-1 d-flex align-items-end">

    <button class="btn btn-primary" @onclick="ApplyFiltersAsync">

      Apply

    </button>

  </div>

</div>


@if (isLoading)
{
  <div class="alert alert-info">
    Loading products...
  </div>
}
else if (products.Count == 0)
{
  <div class="alert alert-warning">
    No products found.
  </div>
}
else
{
  @foreach (var product in products)
  {
    <ProductCard Id="@product.Id" Name="@product.Name" Price="@product.Price" CategoryName="@product.CategoryName"
                 OnSelected="SelectProduct" OnDelete="DeleteProductAsync" ShowAdminActions="@AuthState.IsAdmin" />
  }
}


@if (!string.IsNullOrWhiteSpace(
        selectedProduct))
{
  <div class="alert alert-success mt-3">

    Selected product:
    @selectedProduct

  </div>
}


@if (!isLoading &&
     totalCount > 0)
{
  <div class="mt-4">

    <p>
      Page @query.Page
      of @totalPages
      — Total products:
      @totalCount
    </p>


    <button class="btn btn-secondary me-2" disabled="@(query.Page <= 1)" @onclick="PreviousPageAsync">

      Previous

    </button>


    <button class="btn btn-secondary" disabled="@(query.Page >= totalPages)" @onclick="NextPageAsync">

      Next

    </button>

  </div>
}


@code
{
  private List<ProductResponse> products =
      [];


  private List<CategoryResponse> categories =
      [];


  private ProductQueryParameters query =
      new()
      {
        Page = 1,
        PageSize = 3,
        SortDirection = "asc"
      };


  private string selectedProduct = "";

  private string? errorMessage;


  private bool isLoading = true;


  private int totalCount;

  private int totalPages;


  protected override async Task
      OnInitializedAsync()
  {
    await LoadCategoriesAsync();

    await LoadProductsAsync();
  }


  protected override async Task
      OnAfterRenderAsync(
          bool firstRender)
  {
    if (!firstRender)
    {
      return;
    }


    await AuthState.LoadUserAsync();


    StateHasChanged();
  }


  private async Task LoadCategoriesAsync()
  {
    try
    {
      categories =
          await CategoryApiClient
              .GetAllAsync();
    }
    catch (HttpRequestException)
    {
      errorMessage =
          "Could not load categories from the API.";
    }
  }


  private async Task LoadProductsAsync()
  {
    try
    {
      isLoading = true;

      errorMessage = null;


      PagedResponse<ProductResponse>? response =
          await ProductApiClient
              .GetAllAsync(query);


      if (response is null)
      {
        products = [];

        totalCount = 0;

        totalPages = 0;

        return;
      }


      products =
          response.Items;


      totalCount =
          response.TotalCount;


      totalPages =
          response.TotalPages;
    }
    catch (HttpRequestException)
    {
      products = [];

      totalCount = 0;

      totalPages = 0;


      errorMessage =
          "Could not load products from the API.";
    }
    finally
    {
      isLoading = false;
    }
  }


  private async Task ApplyFiltersAsync()
  {
    query.Page = 1;

    await LoadProductsAsync();
  }


  private async Task PreviousPageAsync()
  {
    if (query.Page <= 1)
    {
      return;
    }


    query.Page--;


    await LoadProductsAsync();
  }


  private async Task NextPageAsync()
  {
    if (query.Page >= totalPages)
    {
      return;
    }


    query.Page++;


    await LoadProductsAsync();
  }


  private void SelectProduct(
      string productName)
  {
    selectedProduct =
        productName;
  }


  private async Task DeleteProductAsync(
      int productId)
  {
    bool confirmed =
        await JS.InvokeAsync<bool>(
            "confirm",
            "Are you sure you want to delete this product?");


    if (!confirmed)
    {
      return;
    }


    try
    {
      errorMessage = null;


      HttpResponseMessage response =
          await ProductApiClient
              .DeleteAsync(productId);


      if (response.IsSuccessStatusCode)
      {
        products.RemoveAll(
            product =>
                product.Id ==
                productId);


        if (totalCount > 0)
        {
          totalCount--;
        }


        return;
      }


      if (response.StatusCode ==
          System.Net.HttpStatusCode.Unauthorized)
      {
        errorMessage =
            "You must login first.";

        return;
      }


      if (response.StatusCode ==
          System.Net.HttpStatusCode.Forbidden)
      {
        errorMessage =
            "You do not have permission to delete products.";

        return;
      }


      if (response.StatusCode ==
          System.Net.HttpStatusCode.NotFound)
      {
        errorMessage =
            "Product was not found.";

        return;
      }


      errorMessage =
          $"Could not delete product. Status: {(int)response.StatusCode}";
    }
    catch (HttpRequestException)
    {
      errorMessage =
          "Could not connect to the API.";
    }
  }
}