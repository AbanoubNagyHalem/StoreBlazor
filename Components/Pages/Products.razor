@page "/products"
@rendermode InteractiveServer
@inject ProductApiClient ProductApiClient

<PageTitle>Products</PageTitle>

<h1>Products</h1>

<div class="row mb-3">
  <div class="col-md-6">
    <label class="form-label">
      Search
    </label>

    <input class="form-control" @bind="query.Search" @bind:event="oninput" />
  </div>

  <div class="col-md-3 d-flex align-items-end">
    <button class="btn btn-primary" @onclick="SearchAsync">
      Search
    </button>
  </div>
</div>

@if (isLoading)
{
  <p>Loading products...</p>
}
else if (errorMessage is not null)
{
  <div class="alert alert-danger">
    @errorMessage
  </div>
}
else if (products.Count == 0)
{
  <p>No products found.</p>
}
else
{
  @foreach (var product in products)
  {
    <ProductCard Name="@product.Name" Price="@product.Price" OnSelected="SelectProduct" />
  }
}

@if (!isLoading && errorMessage is null)
{
  <div class="mt-4">
    <p>
      Page @query.Page of @totalPages
      — Total products: @totalCount
    </p>

    <button class="btn btn-secondary me-2" disabled="@(query.Page <= 1)" @onclick="PreviousPageAsync">
      Previous
    </button>

    <button class="btn btn-secondary" disabled="@(query.Page >= totalPages)" @onclick="NextPageAsync">
      Next
    </button>
  </div>
}

@if (!string.IsNullOrEmpty(selectedProduct))
{
  <div class="alert alert-success mt-3">
    Selected product: @selectedProduct
  </div>
}

@code
{
  private List<ProductResponse> products = [];

  private string selectedProduct = "";

  private bool isLoading = true;

  private string? errorMessage;

  private ProductQueryParameters query = new();

  private int totalPages;
  private int totalCount;


  protected override async Task OnInitializedAsync()
  {
    await LoadProductsAsync();
  }

  private async Task LoadProductsAsync()
  {
    try
    {
      isLoading = true;
      errorMessage = null;

      PagedResponse<ProductResponse>? response =
          await ProductApiClient.GetAllAsync(query);

      products = response?.Items ?? [];

      totalPages = response?.TotalPages ?? 0;
      totalCount = response?.TotalCount ?? 0;
    }
    catch (HttpRequestException)
    {
      errorMessage =
          "Could not load products from the API.";
    }
    finally
    {
      isLoading = false;
    }
  }
  private async Task SearchAsync()
  {
    query.Page = 1;

    await LoadProductsAsync();
  }

  private void SelectProduct(string productName)
  {
    selectedProduct = productName;
  }

  private async Task PreviousPageAsync()
  {
    if (query.Page <= 1)
    {
      return;
    }

    query.Page--;

    await LoadProductsAsync();
  }

  private async Task NextPageAsync()
  {
    if (query.Page >= totalPages)
    {
      return;
    }

    query.Page++;

    await LoadProductsAsync();
  }
}