@page "/products"
@rendermode InteractiveServer

@inject ProductApiClient ProductApiClient
@inject CategoryApiClient CategoryApiClient
@inject AuthStateService AuthState
@inject IJSRuntime JS

<PageTitle>Products</PageTitle>

<div class="products-page">

  <div class="page-header">

    <div>
      <h1>Products</h1>

      <p class="text-muted">
        Browse and manage store products.
      </p>
    </div>

    @if (AuthState.IsAdmin)
    {
      <a href="/products/create" class="btn btn-dark">

        + Add Product

      </a>
    }

  </div>

  <ProductFilters Search="@query.Search" SearchChanged="OnSearchChanged" CategoryId="@query.CategoryId"
                  CategoryIdChanged="OnCategoryChanged" SortBy="@query.SortBy" SortByChanged="OnSortByChanged"
                  SortDirection="@query.SortDirection" SortDirectionChanged="OnSortDirectionChanged" Categories="@categories"
                  OnApply="ApplyFiltersAsync" />

  @if (errorMessage is not null)
  {
    <div class="alert alert-danger">
      @errorMessage
    </div>
  }

  @if (!string.IsNullOrWhiteSpace(selectedProduct))
  {
    <div class="alert alert-success">

      Selected product:

      <strong>
        @selectedProduct
      </strong>

    </div>
  }

  @if (isLoading)
  {
    <div class="products-loading">

      <div class="spinner-border" role="status">

        <span class="visually-hidden">
          Loading...
        </span>

      </div>

      <p>
        Loading products...
      </p>

    </div>
  }
  else if (products.Count == 0)
  {
    <div class="empty-state">

      <h3>
        No products found
      </h3>

      <p>
        Try changing your search or filters.
      </p>

    </div>
  }
  else
  {
    <div class="products-grid">

      @foreach (var product in products)
      {
        <ProductCard Id="@product.Id" Name="@product.Name" Price="@product.Price" CategoryName="@product.CategoryName"
                     OnSelected="SelectProduct" OnDelete="DeleteProductAsync" ShowAdminActions="@AuthState.IsAdmin" />
      }

    </div>

    <ProductPagination CurrentPage="@query.Page" TotalPages="@totalPages" TotalCount="@totalCount"
                       OnPrevious="PreviousPageAsync" OnNext="NextPageAsync" />
  }

</div>

@code {
  private List<ProductResponse> products = [];

  private List<CategoryResponse> categories = [];

  private ProductQueryParameters query =
      new()
      {
        Page = 1,
        PageSize = 6,
        SortDirection = "asc"
      };

  private string selectedProduct = "";

  private string? errorMessage;

  private bool isLoading = true;

  private int totalCount;

  private int totalPages;

  protected override async Task OnInitializedAsync()
  {
    await LoadCategoriesAsync();

    await LoadProductsAsync();
  }

  protected override async Task OnAfterRenderAsync(
      bool firstRender)
  {
    if (!firstRender)
    {
      return;
    }

    await AuthState.LoadUserAsync();

    StateHasChanged();
  }

  private async Task LoadCategoriesAsync()
  {
    try
    {
      categories =
          await CategoryApiClient.GetAllAsync();
    }
    catch (HttpRequestException)
    {
      errorMessage =
          "Could not load categories.";
    }
  }

  private async Task LoadProductsAsync()
  {
    try
    {
      isLoading = true;

      errorMessage = null;

      PagedResponse<ProductResponse>? response =
          await ProductApiClient.GetAllAsync(query);

      if (response is null)
      {
        products = [];

        totalCount = 0;

        totalPages = 0;

        return;
      }

      products = response.Items;

      totalCount = response.TotalCount;

      totalPages = response.TotalPages;
    }
    catch (HttpRequestException)
    {
      products = [];

      totalCount = 0;

      totalPages = 0;

      errorMessage =
          "Could not load products.";
    }
    finally
    {
      isLoading = false;
    }
  }

  private Task OnSearchChanged(
      string? value)
  {
    query.Search = value;

    return Task.CompletedTask;
  }

  private Task OnCategoryChanged(
      int? value)
  {
    query.CategoryId = value;

    return Task.CompletedTask;
  }

  private Task OnSortByChanged(
      string? value)
  {
    query.SortBy = value;

    return Task.CompletedTask;
  }

  private Task OnSortDirectionChanged(
      string value)
  {
    query.SortDirection = value;

    return Task.CompletedTask;
  }

  private async Task ApplyFiltersAsync()
  {
    query.Page = 1;

    await LoadProductsAsync();
  }

  private async Task PreviousPageAsync()
  {
    if (query.Page <= 1)
    {
      return;
    }

    query.Page--;

    await LoadProductsAsync();
  }

  private async Task NextPageAsync()
  {
    if (query.Page >= totalPages)
    {
      return;
    }

    query.Page++;

    await LoadProductsAsync();
  }

  private void SelectProduct(
      string productName)
  {
    selectedProduct =
        productName;
  }

  private async Task DeleteProductAsync(
      int productId)
  {
    bool confirmed =
        await JS.InvokeAsync<bool>(
            "confirm",
            "Are you sure you want to delete this product?");

    if (!confirmed)
    {
      return;
    }

    try
    {
      errorMessage = null;

      HttpResponseMessage response =
          await ProductApiClient.DeleteAsync(
              productId);

      if (response.IsSuccessStatusCode)
      {
        await LoadProductsAsync();

        return;
      }

      if (response.StatusCode ==
          System.Net.HttpStatusCode.Unauthorized)
      {
        errorMessage =
            "You must login first.";

        return;
      }

      if (response.StatusCode ==
          System.Net.HttpStatusCode.Forbidden)
      {
        errorMessage =
            "You do not have permission.";

        return;
      }

      if (response.StatusCode ==
          System.Net.HttpStatusCode.NotFound)
      {
        errorMessage =
            "Product was not found.";

        return;
      }

      errorMessage =
          $"Delete failed. Status: {(int)response.StatusCode}";
    }
    catch (HttpRequestException)
    {
      errorMessage =
          "Could not connect to the API.";
    }
  }
}