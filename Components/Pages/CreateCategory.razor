@page "/categories/create"

@inject CategoryApiClient CategoryApiClient
@inject AdminPageGuard AdminPageGuard
@inject NavigationManager Navigation

<PageTitle>Create Category</PageTitle>


<div class="form-page">

  <div class="form-page-header">

    <span class="page-eyebrow">
      CATEGORIES
    </span>

    <h1>
      Create Category
    </h1>

    <p>
      Add a new product category.
    </p>

  </div>


  @if (errorMessage is not null)
  {
    <div class="alert alert-danger">
      @errorMessage
    </div>
  }


  @if (successMessage is not null)
  {
    <div class="alert alert-success">
      @successMessage
    </div>
  }


  <div class="category-form">

    <EditForm Model="@model" OnValidSubmit="HandleCreateAsync">

      <DataAnnotationsValidator />

      <ValidationSummary />


      <div class="mb-4">

        <label class="form-label">
          Category Name
        </label>

        <InputText class="form-control" @bind-Value="model.Name" placeholder="Enter category name" />

        <ValidationMessage For="@(() => model.Name)" />

      </div>


      <div class="form-actions">

        <button type="submit" class="btn btn-dark" disabled="@isSubmitting">

          @if (isSubmitting)
          {
            <span class="spinner-border spinner-border-sm me-2"></span>

            <span>
              Creating...
            </span>
          }
          else
          {
            <span>
              Create Category
            </span>
          }

        </button>


        <button type="button" class="btn btn-outline-secondary" disabled="@isSubmitting" @onclick="GoBack">

          Cancel

        </button>

      </div>

    </EditForm>

  </div>

</div>


@code {
  private CreateCategoryRequest model =
      new();


  private bool isSubmitting;


  private string? errorMessage;

  private string? successMessage;


  protected override async Task OnAfterRenderAsync(
      bool firstRender)
  {
    if (!firstRender)
    {
      return;
    }


    bool allowed =
        await AdminPageGuard.EnsureAdminAsync(
            "/categories");


    if (!allowed)
    {
      return;
    }


    StateHasChanged();
  }


  private async Task HandleCreateAsync()
  {
    try
    {
      isSubmitting = true;

      errorMessage = null;

      successMessage = null;


      HttpResponseMessage response =
          await CategoryApiClient.CreateAsync(
              model);


      if (response.IsSuccessStatusCode)
      {
        successMessage =
            "Category created successfully.";

        model =
            new CreateCategoryRequest();

        return;
      }


      if (response.StatusCode ==
          System.Net.HttpStatusCode.Conflict)
      {
        errorMessage =
            "A category with this name already exists.";

        return;
      }


      if (response.StatusCode ==
          System.Net.HttpStatusCode.Unauthorized ||
          response.StatusCode ==
          System.Net.HttpStatusCode.Forbidden)
      {
        errorMessage =
            "You do not have permission to create categories.";

        return;
      }


      errorMessage =
          $"Could not create category. Status: {(int)response.StatusCode}";
    }
    catch (HttpRequestException)
    {
      errorMessage =
          "Could not connect to the API.";
    }
    finally
    {
      isSubmitting = false;
    }
  }


  private void GoBack()
  {
    Navigation.NavigateTo(
        "/categories");
  }
}