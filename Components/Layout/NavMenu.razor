@implements IDisposable

@inject AuthStateService AuthState
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation


<div class="sidebar-brand">

    <a href="/" class="brand-link">

        <span class="brand-icon">
            S
        </span>

        <div>
            <div class="brand-name">
                Store
            </div>

            <div class="brand-subtitle">
                Management
            </div>
        </div>

    </a>

</div>


<input type="checkbox" title="Navigation menu" class="navbar-toggler" />


<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">

    <nav class="sidebar-nav">

        <div class="nav-section-title">
            STORE
        </div>


        <NavLink class="sidebar-link" href="" Match="NavLinkMatch.All">

            <span class="sidebar-icon">
                🏠
            </span>

            <span>
                Home
            </span>

        </NavLink>


        <NavLink class="sidebar-link" href="products">

            <span class="sidebar-icon">
                📦
            </span>

            <span>
                Products
            </span>

        </NavLink>


        <NavLink class="sidebar-link" href="categories">

            <span class="sidebar-icon">
                🗂️
            </span>

            <span>
                Categories
            </span>

        </NavLink>


        @if (isAuthLoaded && isAdmin)
        {
            <NavLink class="sidebar-link" href="products/create">

                <span class="sidebar-icon">
                    ➕
                </span>

                <span>
                    Add Product
                </span>

            </NavLink>


            <NavLink class="sidebar-link" href="categories/create">

                <span class="sidebar-icon">
                    ⊕
                </span>

                <span>
                    Add Category
                </span>

            </NavLink>
        }


        <div class="nav-divider"></div>


        <div class="nav-section-title">
            ACCOUNT
        </div>


        @if (isLoaded)
        {
            @if (!AuthState.IsAuthenticated)
            {
                <NavLink class="sidebar-link" href="login">

                    <span class="sidebar-icon">
                        🔐
                    </span>

                    <span>
                        Login
                    </span>

                </NavLink>
            }
            else
            {
                <div class="user-card">

                    <div class="user-avatar">
                        @GetInitial()
                    </div>

                    <div class="user-info">

                        <div class="user-name">
                            @AuthState.Name
                        </div>

                        <div class="user-role">
                            @AuthState.Role
                        </div>

                    </div>

                </div>


                <button type="button" class="sidebar-link logout-button" @onclick="LogoutAsync">

                    <span class="sidebar-icon">
                        ↪
                    </span>

                    <span>
                        Logout
                    </span>

                </button>
            }
        }

    </nav>

</div>


@code {
    private bool isLoaded;

    private bool isAuthLoaded;

    private bool isAdmin;


    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }


        // النظام القديم ما زال مسؤولًا عن تحميل
        // البيانات من sessionStorage
        await AuthState.LoadUserAsync();

        AuthState.OnChange +=
            HandleAuthStateChanged;

        // اسمع أي تغيير يحصل في AuthenticationStateProvider
        AuthenticationStateProvider.AuthenticationStateChanged +=
            HandleAuthenticationStateChanged;


        await LoadAuthenticationStateAsync();


        isLoaded = true;

        StateHasChanged();
    }


    private async Task LoadAuthenticationStateAsync()
    {
        AuthenticationState state =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();


        isAdmin =
            state.User.IsInRole("Admin");


        isAuthLoaded = true;
    }


    private void HandleAuthenticationStateChanged(
        Task<AuthenticationState> authenticationStateTask)
    {
        _ = InvokeAsync(
            async () =>
            {
                AuthenticationState state =
                    await authenticationStateTask;


                isAdmin =
                    state.User.IsInRole("Admin");


                isAuthLoaded = true;


                StateHasChanged();
            });
    }


    private string GetInitial()
    {
        if (string.IsNullOrWhiteSpace(
                AuthState.Name))
        {
            return "?";
        }


        return AuthState.Name
            .Trim()[0]
            .ToString()
            .ToUpperInvariant();
    }


    private async Task LogoutAsync()
    {
        await AuthState.LogoutAsync();


        Navigation.NavigateTo(
            "/login");
    }


    public void Dispose()
    {
        AuthState.OnChange -=
            HandleAuthStateChanged;


        AuthenticationStateProvider.AuthenticationStateChanged -=
            HandleAuthenticationStateChanged;
    }


    private void HandleAuthStateChanged()
    {
        InvokeAsync(
            StateHasChanged);
    }
}